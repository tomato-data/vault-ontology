# The vault's schema, as data. Phase 8.
#
# Phase 4 kept this in code: `TYPES = {...}` and `if t not in TYPES: reject()`.
# Here it is a graph the reasoner can read and a query can ask about.
#
# Every property below carries `rdfs:comment` naming the query it answers.
# A property that answers no query is deleted, not documented.

@prefix v:       <https://tomato.vault/schema/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

#################################################################
# Classes — the type hierarchy is by ROLE, not by subject.
#
# The 13 type values do not form a semantic tree; grouping
# concept/procedure/reference answers no query. What earns a
# superclass is the role a note plays: did I write it, did it
# come from elsewhere, or is it scaffolding.
#
# Every leaf carries the `Document` suffix. Phase 13 put it there.
# Before it, `v:Principle` named the FILE whose `type:` is principle —
# but that name reads as the principle itself, which is what the file
# is about, not what it is. Two resources, one name. The suffix is the
# whole fix: a name ending in Document is a note on disk, and the bare
# name is left free for the knowledge entity Phase 13 introduces.
#
# There is deliberately NO compatibility axiom. An
# `owl:equivalentClass v:Principle` would keep the old name resolving,
# and under the OWL RL closure of Phase 9 it would type every document
# as `v:Principle` again — reinstating the exact ambiguity this rename
# removes. Nothing reads the generated .vault.ttl, so nothing needs it.
#################################################################

v:Document   a rdfs:Class ;
    rdfs:comment "Any note that is a node in the graph." .

v:Content    a rdfs:Class ; rdfs:subClassOf v:Document ;
    rdfs:comment "A note I authored. Query: my own thinking, source-notes and scaffolding excluded." .
v:Imported   a rdfs:Class ; rdfs:subClassOf v:Document ;
    rdfs:comment "A note that came from elsewhere. Query: what did I take in versus write." .
v:Structural a rdfs:Class ; rdfs:subClassOf v:Document ;
    rdfs:comment "Scaffolding, not content. Query: exclude these when counting real notes or finding orphans." .

# Content — the ten authored types.
v:ConceptDocument    rdfs:subClassOf v:Content .
v:ProcedureDocument  rdfs:subClassOf v:Content .
v:ReferenceDocument  rdfs:subClassOf v:Content .
v:PrincipleDocument  rdfs:subClassOf v:Content .
v:DecisionDocument   rdfs:subClassOf v:Content .
v:CaseDocument       rdfs:subClassOf v:Content .
v:LogDocument        rdfs:subClassOf v:Content .
v:ReflectionDocument rdfs:subClassOf v:Content .
v:ProjectDocument    rdfs:subClassOf v:Content .
v:TradeoffDocument   rdfs:subClassOf v:Content .

# Imported — one type.
v:SourceNoteDocument rdfs:subClassOf v:Imported .

# Structural — two types.
v:HubDocument        rdfs:subClassOf v:Structural .
v:TemplateDocument   rdfs:subClassOf v:Structural .

v:Folder a rdfs:Class ;
    rdfs:comment "A directory, a resource in its own right since Phase 6." .

#################################################################
# Properties we own. Each is a subproperty of a standard, so a
# tool that knows the standard understands ours.
#################################################################

v:builds_on a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:subPropertyOf dcterms:references ;
    rdfs:domain v:Content ; rdfs:range v:Content ;
    rdfs:comment "Curated prerequisites. Query: what must I read before this note (q path). Declared transitive; the closure is NOT materialised until Phase 9." .

v:links_to a owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:references ;
    rdfs:domain v:Document ; rdfs:range v:Document ;
    rdfs:comment "A body wikilink that resolved. Query: neighbours of a note (q near, the forward half)." .

v:linked_by a owl:ObjectProperty ;
    owl:inverseOf v:links_to ;
    rdfs:comment "The backlink. Query: what points at this note (q near, the reverse half). Not materialised until Phase 9; Phase 7 read it with ^." .

v:hub a owl:ObjectProperty ;
    rdfs:subPropertyOf foaf:primaryTopic ;
    rdfs:domain v:Folder ; rdfs:range v:Document ;
    rdfs:comment "The note that represents a folder. Query: given a folder, its landing note." .

#################################################################
# Standard properties we reuse directly. We add local domain/range
# so THIS graph can reason over them; that scopes the reused term
# to the vault and does not change its meaning elsewhere.
#################################################################

# NO rdfs:domain here on purpose. isPartOf is shared: a document is part of
# a folder, and a folder is part of its parent folder. A domain of v:Document
# would fire on the folder subjects too and mistype 764 nested folders as
# Documents - inference, not validation (measured, Phase 9). The range stays:
# every object of isPartOf is a folder, which is what types folders v:Folder.
dcterms:isPartOf rdfs:range v:Folder ;
    rdfs:comment "Folder membership, derived from the path. Query: every note under a folder." .

dcterms:subject  rdfs:domain v:Document ; rdfs:range skos:Concept ;
    rdfs:comment "A tag the note carries. The tag is a skos:Concept, so its hierarchy is walkable. Query: notes on a topic, nesting included (q tag)." .

dcterms:replaces rdfs:domain v:Document ; rdfs:range v:Document ;
    rdfs:comment "This note supersedes an older one. Often points at a deleted note, which is the normal case, not a fault." .

dcterms:created  rdfs:domain v:Document ;
    rdfs:comment "When the note was made. Central to the dated types, incidental to the rest." .

dcterms:abstract rdfs:domain v:Document ;
    rdfs:comment "The note's own summary line. Required of the content types by the schema of record." .
